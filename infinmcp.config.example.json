{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "apiKeys": [
      { "name": "chenning", "key": "{env:KEY_CHENNING}", "role": "admin" },
      { "name": "alice", "key": "{env:KEY_ALICE}", "role": "user" }
    ],
    "allowAiConnectionWrites": false
  },
  "connections": {
    "main": {
      "type": "mysql",
      "host": "10.0.0.11",
      "port": 3306,
      "user": "readonly",
      "password": "{env:MYSQL_PW}",
      "database": "app",
      "env": "prod",
      "readonly": true
    },
    "warehouse": {
      "type": "doris",
      "host": "10.0.0.14",
      "port": 9030,
      "user": "readonly",
      "password": "{env:DORIS_PW}",
      "database": "app",
      "env": "test",
      "readonly": true,
      "maxRows": 100
    },
    "cache": {
      "type": "redis",
      "host": "10.0.0.12",
      "port": 6379,
      "db": 0,
      "env": "dev"
    },
    "docs": {
      "type": "mongodb",
      "uri": "{env:MONGO_URI}",
      "database": "app",
      "env": "dev"
    }
  },
  "limits": {
    "maxRows": 200,
    "timeoutMs": 10000,
    "maxCellWidth": 512,
    "inlineMaxBytes": 262144,
    "inlineMaxRows": 1000,
    "exportTtlHours": 24,
    "exportMaxFiles": 200
  },
  "logs": {
    "file": "~/.infinmcp/logs.jsonl"
  }
}
