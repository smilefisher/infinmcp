# infinmcp 环境变量示例：复制为 .env 后按需修改（.env 不要提交到 git）

# 服务端 API Key（每人一个，name 在配置文件的 server.apiKeys 里引用）
KEY_CHENNING=change-me-admin-key
KEY_ALICE=change-me-user-key

# 数据库口令 / 连接串（在配置文件中用 {env:...} 引用）
MYSQL_PW=change-me
DORIS_PW=change-me
MONGO_URI=mongodb://readonly:change-me@10.0.0.13:27017/?authSource=admin
REDIS_PW=

# 可选：显式指定配置文件 / 数据目录
# INFINMCP_CONFIG=./infinmcp.config.json
# INFINMCP_DATA_DIR=~/.config/infinmcp
